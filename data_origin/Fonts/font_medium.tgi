/**************************************************************************

medium.tgi
Copyright ?2002-2004 TimeGate Studios

DESCRIPTION: Describes the contents of a font.

REVISION HISTORY:
drp033104 - created


**************************************************************************/
[Font template = Font]
{
	ids = medium
	name = "#font_medium_name"
	size = 10 ;; this is the Windows font size, not the actual pixel height of glyphs.

	[CharacterSet]
	{
		ids = base
		font = /fonts/truetype/A&A.TTF
		bold = true
		shadow = true
		shadow_opacity = .4
		
								;backup_font = Arial
                backup_font = /fonts/truetype/A&A.TTF
                backup_font_size = 11
                use_backup_font_when_smaller_than = 11
	}
	
	[CharacterSet]
	ids = hangul_jamo
	font = /fonts/truetype/A&A.TTF
	


	[CharacterSet]
	ids = hangul_johab
	font = /fonts/truetype/A&A.TTF
}
