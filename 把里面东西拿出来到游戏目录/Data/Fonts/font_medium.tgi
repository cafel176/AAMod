/**************************************************************************

medium.tgi
Copyright ?2002-2004 TimeGate Studios

DESCRIPTION: Describes the contents of a font.

REVISION HISTORY:
drp033104 - created


**************************************************************************/
[Font template = Font]
{
	ids = medium
	name = "#font_medium_name"
	size = 13 ;; this is the Windows font size, not the actual pixel height of glyphs.

	[CharacterSet]
	{
		ids = base
		font = simsun
		bold = false
		shadow = false
		shadow_opacity = .4
		
								;backup_font = Arial
                backup_font = simsun
                backup_font_size = 11
                use_backup_font_when_smaller_than = 12
	}
	
	[CharacterSet]
	ids = hangul_jamo
	font = Gulim
	
	[CharacterSet]
	ids = hiragana_katakana
	font = simsun

	[CharacterSet]
	ids = han
	font = simsun

	[CharacterSet]
	ids = hangul_johab
	font = Gulim
}
