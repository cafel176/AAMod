[Thing Template=AAUnitGBRVehicleLightTank]
{
	;;IDS = gbr_light_tank
	IDS = gbr_tank_light3
	name = "#gbr_tank_light_name"
	editor_name = "#gbr_tank_light_editor_name"

	[BodyComponent]
	{
		health = 300
		defense = 14
	}

	[ElementComponent]

	[MoverComponent]
	{
		speed_max = 4
		acceleration = 3
				
		[WhenStartMoving template=FXC_CreateVFX]
		{
			VFX_IDS = start_exhaust_01
			location = exhaust_point_01	
	  	}
	  	
	  	[WhenStartMoving template=FXC_CreateVFX]
		{
			VFX_IDS = start_exhaust_01
			location = exhaust_point_02	
	  	}
	}
	
	[PerformerComponent]
	{
		check_damage_resistance = true


                [Ability template=AATurretAttackLocal]
		{
                       
			[AbilityDefinition Template=AALightTankGun]
			{				
				name = "#gbr_tank_light_AbilityDefinition_name"
				recharge_time = 6
				area = 1
				range = 18
				
				[WhenDo Template=FXC_PlayObjectAnimation]
				object_animation_IDS = Recoil1
				
				[Effect Template=APDamageEffect]
				amount = 50
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = gbr_cannon_light
			}
		}


		
	}

	[DefenderComponent]
	{
		control_range = 12
	
		[Ability Template=AAAttackLocal]
		{
				
			
			[AbilityDefinition Template=AATankMG]
			{
				name = "#gbr_halftrack_AbilityDefinition_name"
				area = 1.5
				attenuation_range_min = 0.5
				attenuation_factor_max = 0.5
				max_targets = 2

				recharge_time = 2
				range = 12
				
				
				[Effect Template=PierceDamageEffect]
				amount = 14
			
				[WhenDo template=FXC_PlaySFX]
				audio_ids = gbr_mg_heavy

				[Flags]
				spell = true
			}

	
		
		}
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = front
		
		[Property]
		property_IDS = support
		
		[Property]
		property_IDS = combat_unit
	}
	
	[View]
	{
		resource_prefix = GBRTankLight/GBRTankLight
		
		[AspectNormal]
		{						
			[Animation Template=ObjectAnimationCustomPlay]
			ids = Recoil1
			length = 1
			kf = GBRTankLight/GBRTankLightRecoil1.kf
		}
	}
}
