[Thing Template=AAUnitGERProne]
{
	IDS = ger_paratrooper_at
	name = "#ger_paratrooper_at_name"
	editor_name = "#ger_paratrooper_at_editor_name"
	category = UNIT

	hide_if_missing_properties = false
	
	[Stance template = StanceFalling]
	
	[View]
	{
		resource_prefix = GERInfantryAT/GERInfantryAT
		
		[Aspect Template=AspectFalling]
		{
			IDS = falling
			model = GERParatrooper/GERParatrooperFalling.nif
			disable_animations = true
		}

		[TextureSearchPath]
		{
			path = /effects/parachute/GER
		}

		[WhenCreated Template=FXC_Equipment]
		action = HIDE
		location = base
		equipment_type_ids = mortarup

		[WhenCreated Template=FXC_Equipment]
		action = HIDE
		location = rhand
		equipment_type_ids = shellup

		[WhenCreated Template=FXC_Equipment]
		action = UNHIDE
		location = rhand
		equipment_type_ids = mortardown
	}
	
	[BodyComponent]
	health = 150
	defense = 3
	
	[ElementComponent]
	{
		required_structures = ger_motor_pool3
	}
		
	[CharacterComponent Template=AAInfantryATCharacterComponent]
	
	[MoverComponent]
	{
		speed_max = 2.5
	}
	
	[PropertiesComponent]
	{
		[Property]
		property_IDS = front
		
		[Property]
		property_IDS = support

		[Property]
		property_IDS = at_infantry			

		[Property]
		property_IDS = property_infantry_unit
		
		[Property]
		property_IDS = combat_unit
	}
	
	[PerformerComponent]
	{
		check_damage_resistance = true

		[Ability template=AAAttackLocal]
		{
			spawn_bone_ids = cannon_ae_01
			
			[AbilityDefinition Template=AAInfantryRocket]
			{				
				name = "#ger_infantry_at_AbilityDefinition_name"
				recharge_time = 5
				range = 16
				
				[Effect Template=APDamageEffect]
				amount = 85

				[WhenDo template=FXC_PlaySFX]
				audio_ids = ger_rocket
			
				[Effect Template=EnchantmentEffect]
				{
					[EnchantmentProperty Template=EnchantmentProperty]
					{
					IDS = at_stun_ger6
					name = "#gbr_infantry_at_AbilityDefinition_Effect_EnchantmentProperty_name"
					duration = 1.0
					enchantment_type = ench_type_generic
					icon = /properties/PropertyIcons/IconPropertyMovement.png
			
						[Modifier Template=FlagModifier]
						modifier_flag = PARALYZE			
						
						[WhenAdded template=FXC_CreateVFX]
						VFX_IDS = smoke_tint
						
					}
				}			
			}
		}


	}

	[WhenLeave Template=FXC_CreateVFX]
	{
		vfx_ids = parachute_close_ger
		actor_state = falling
		location = neck
	}
}