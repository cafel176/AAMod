[Thing Template=AAJPNOrganizationMobile]
{	
	IDS = regiment_jpn_halftrack2
	name = "#regiment_jpn_halftrack_name"
	editor_name = "#regiment_jpn_halftrack_editor_name"

	[EconomyComponent]
	{
		[Cost]
		money = 35
		
		[Upkeep]
		ammo = 5
		oil = 5
	}

	[View]
	{
		resource_prefix = /Units/JPN/JPNHalftrack/JPNHalftrack
		icon = /UI/Game/RegimentButtons/IconHalftrack.png

		[WhenCreated Template=FXC_PlaySFX]
		audio_ids = jpn_vehicle_deployed

		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = jpn_halftrack_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = jpn_halftrack_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = jpn_halftrack_attack
	}
	
	[OrganizationComponent Template=AAVehicleOrganizationComponent]
	{	
		layout_IDS = regiment_vehicle_light
		recruit_time = 15
		recruit_full = true

		[Slot]	;; front
		element_IDS = jpn_halftrack2
	
		[Slot]	;; support
		element_IDS = null
		
		[Slot]	;; captain
		element_IDS = jpn_car_armored_co2
	}
	
	[PropertiesComponent]
	{	
		[Property]
		property_ids = mechanized_company

        [Property]
		property_IDS = recon	
	}
}