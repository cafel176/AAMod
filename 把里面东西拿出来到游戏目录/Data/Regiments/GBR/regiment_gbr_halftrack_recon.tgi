[Thing Template=AAGBROrganizationMobile]
{	
	IDS = regiment_gbr_halftrack_recon
	name = "#regiment_gbr_infantry_recon_name"
	editor_name = "#regiment_gbr_infantry_recon_editor_name"

	[DetectionComponent]
	{
		detection_range = 35
	}
	[EconomyComponent]
	{
		[Cost]
		money = 35
		
		[Upkeep]		
		oil = 3
	}



	[View]
	{
		resource_prefix = /Units/GBR/GBRHalftrack/GBRHalftrack
		icon = /UI/Game/RegimentButtons/IconInfantryRecon.png

		[WhenCreated Template=FXC_PlaySFX]
		audio_ids = gbr_vehicle_deployed

		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = gbr_halftrack_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = gbr_halftrack_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = gbr_halftrack_attack
	}		
	
	[OrganizationComponent Template=AAInfantryOrganizationComponent]
	{
		layout_ids = regiment_single_unit
		
		[Slot]	;; captain
		element_IDS = gbr_car_armored_recon
	}
	
	[PropertiesComponent]
	{	
		[Property]
		property_ids = mechanized_company

	        [Property]
		property_IDS = recon	
	
	}
}