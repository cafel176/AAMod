[Thing Template=AAusaOrganizationMobile]
{	
	IDS = regiment_usa_halftrack_recon
	name = "#regiment_usa_infantry_recon_name"
	editor_name = "#regiment_usa_infantry_recon_editor_name"

	[DetectionComponent]
	{
		detection_range = 35
	}
	[EconomyComponent]
	{
		[Cost]
		money = 25
		
		[Upkeep]		
		oil = 2
	}



	[View]
	{
		resource_prefix = /Units/usa/usaHalftrack/usaHalftrack
		icon = /UI/Game/RegimentButtons/IconInfantryRecon.png

		[WhenCreated Template=FXC_PlaySFX]
		audio_ids = usa_vehicle_deployed

		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = usa_halftrack_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = usa_halftrack_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = usa_halftrack_attack
	}		
	
	[OrganizationComponent Template=AAInfantryOrganizationComponent]
	{
		layout_ids = regiment_single_unit
		
		[Slot]	;; captain
		element_IDS = usa_car_armored_co3
	}
	
	[PropertiesComponent]
	{	
		[Property]
		property_ids = mechanized_company

	        [Property]
		property_IDS = recon	
		
		[Property]
		property_IDS = trailblazing		
	
	}
}