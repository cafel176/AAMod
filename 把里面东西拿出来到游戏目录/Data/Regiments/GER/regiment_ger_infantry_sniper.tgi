[Thing Template=AAGEROrganizationInfantry]
{
	IDS = regiment_ger_infantry_sniper
	editor_name = "#regiment_rus_infantry_sniper_editor_name"
	name = "#regiment_rus_infantry_sniper_name"
	
	[EconomyComponent]
	{
		[Cost]
		money = 75
		
		[Upkeep]
		ammo = 10
	}

	[View]
	{
		resource_prefix = /Units/GER/GERInfantry/GERInfantry
		icon = /UI/Game/RegimentButtons/IconInfantrySniper.png

		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = ger_infantry_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = ger_infantry_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = ger_infantry_attack
	}		
	
	[OrganizationComponent Template=AAInfantryOrganizationComponent]
	{	
		layout_IDS = regiment_infantry
		
		[Slot]	;; front
		element_IDS = ger_infantry
		
		[Slot]	;; rear guard 1
		element_IDS = ger_infantry

		[Slot]	;; rear guard 2
		element_IDS = ger_infantry
		
		[Slot]	;; rear guard 3
		element_IDS = ger_infantry
	
		[Slot]	;; flank
		element_IDS = ger_infantry_sniper2
		
		[Slot]	;; captain
		element_IDS = ger_infantry_co
	}
	
	[PropertiesComponent]
	{	
		[Property]
		property_ids = infantry_company
	}
}


