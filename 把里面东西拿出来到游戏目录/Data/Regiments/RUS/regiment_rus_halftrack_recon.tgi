[Thing Template=AArusOrganizationMobile]
{	
	IDS = regiment_rus_halftrack_recon
	name = "#regiment_rus_infantry_recon_name"
	editor_name = "#regiment_rus_infantry_recon_editor_name"

	[DetectionComponent]
	{
		detection_range = 35
	}
	[EconomyComponent]
	{
		[Cost]
		money = 35
		
		[Upkeep]	
		oil = 3
	}



	[View]
	{
		resource_prefix = /Units/rus/rusHalftrack/rusHalftrack
		icon = /UI/Game/RegimentButtons/IconInfantryRecon.png

		[WhenCreated Template=FXC_PlaySFX]
		audio_ids = rus_vehicle_deployed

		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = rus_halftrack_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = rus_halftrack_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = rus_halftrack_attack
	}		
	
	[OrganizationComponent Template=AAInfantryOrganizationComponent]
	{
		layout_ids = regiment_single_unit
		
		[Slot]	;; captain
		element_IDS = rus_car_armored_recon
	}
	
	[PropertiesComponent]
	{	
		[Property]
		property_ids = mechanized_company

	        [Property]
		property_IDS = recon		
	
	}
}