[Thing Template=AARUSOrganizationMobile]
{
	IDS = regiment_rus_infantry_armored2
	name = "#regiment_usa_infantry_armored_name"
	editor_name = "#regiment_usa_infantry_armored_editor_name"

	[EconomyComponent]
	{
		[Cost]
		money = 125
		
		[Upkeep]
		ammo = 15
		oil = 10
	}

	[View]
	{
		resource_prefix = /Units/RUS/RUSInfantry/RUSInfantry
		icon = /UI/Game/RegimentButtons/IconInfantryArmored.png
		banner_icon = /Organizations/Banners/Icons/IconArmor.png

		[WhenCreated Template=FXC_PlaySFX]
		audio_ids = rus_tank_deployed

		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = rus_infantry_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = rus_infantry_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = rus_infantry_attack
	}		
	
	[OrganizationComponent Template=AAInfantryOrganizationComponent]
	{	
		layout_IDS = regiment_mechanized
		recruit_time = 15

		[Slot]	;; front
		element_IDS = rus_infantry
		
		[Slot]	;; rear guard 1
		element_IDS = rus_infantry

		[Slot]	;; rear guard 2
		element_IDS = rus_halftrack2
		
		[Slot]	;; rear guard 3
		element_IDS = rus_tank_light2
	
		[Slot]	;; flank
		element_IDS = rus_tank_light2
		
		[Slot]	;; captain
		element_IDS = rus_tank_co2
	}
	
	[PropertiesComponent]
	{	
		[Property]
		property_ids = tank_company
	}
}