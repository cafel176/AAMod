[Template AARUSRegimentEngineer Template=AARUSOrganizationEngineer]
{
	name = "#regiment_rus_engineer_AARUSRegimentEngineer_name"

	[EconomyComponent]
	{
		[Cost]
		money = 65
		
		[Upkeep]
		ammo = 5
		oil = 5
	}

	[View]
	{
		resource_prefix = /Units/RUS/RUSEngineer/RUSEngineer
		icon = /UI/Game/RegimentButtons/IconEngineer.png

		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = rus_engineer_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = rus_engineer_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = rus_engineer_attack
	}		
	
	[OrganizationComponent Template=AAInfantryOrganizationComponent]
	{	
		layout_IDS = regiment_infantry
		
		[Slot]	;; front
		element_IDS = rus_engineer3
		
		[Slot]	;; rear guard 1
		element_IDS = rus_engineer3

		[Slot]	;; rear guard 2
		element_IDS = rus_engineer3
		
		[Slot]	;; rear guard 3
		element_IDS = rus_engineer3
	
		[Slot]	;; flank
		element_IDS = rus_engineer3
		
		[Slot]	;; captain
		element_IDS = rus_infantry_co
	}
}

[Thing Template=AARUSRegimentEngineer]
{
	IDS = regiment_rus_engineer3
	editor_name = "#regiment_rus_engineer_editor_name"

	[PropertiesComponent]
	{
		[Property]
		property_IDS = engineer
	}
}
