[Thing template=Actor]
{
	IDS = thing_unit_limit_resource
	name = "#thing_unit_resource_name"
	category = UNIT
	
	[EconomyComponent]
	{
		[Production]
		unit_limit_consumed = 10
	}
	
	[Flags]
	invulnerable = true
	invisible = true
	blocking = false
	targetable = false
	ethereal = true
	
	[Placement]
	placement_group_IDS = group_special

	[View]
	{
		resource_prefix = ThingUnitResource/ThingUnitResource
		shadow_type = none
		shadow_texture = null

		[TextureSearchPath]
		path = /Shared/SharedTextures
	}

    	[Size]
	{
		blocking_shape = CIRCLE
		blocking_radius = 1
					
		soft_shape = RECT
		rect_width = 1
		rect_height = 1
	}
}